	)
	(text "V_EH: RF energy-harvest output (enable via\nEH_MODE register). Broken out on J3; C3 optional."
		(exclude_from_sim no)
		(at 170.18 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "759af2c3-5bfc-4985-b1d2-62f0cc120dcd")
	)
	(text "NFC antenna (13.56 MHz)\nST25DV has ~28.5 pF internal tuning cap,\nso the coil needs ~4.8 uH.\nDesign the coil with ST eDesignSuite;\nC4 is optional fine-tuning (DNP)."
		(exclude_from_sim no)
		(at 165.1 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9bedfe19-0ce1-43b7-bcfb-29e0349fb5f9")
	)
	(text "Cut JP1 to remove the I2C pull-ups\n(e.g. when chaining several boards).\nGPO is open-drain: R3 pulls it up."
		(exclude_from_sim no)
		(at 50.8 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b53a8003-de18-412c-8895-b5747caa9800")
	)
	(text "STEMMA QT / Qwiic pinout: 1 GND, 2 VCC, 3 SDA, 4 SCL\nJ3: VIN, GND, SCL, SDA, GPO, V_EH\nVCC = 1.8-5.5 V (no regulator: I2C runs at the host's logic level)"
		(exclude_from_sim no)
		(at 22.86 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d317c19a-79f0-4a57-afa5-29b1b8656cf4")
	)
